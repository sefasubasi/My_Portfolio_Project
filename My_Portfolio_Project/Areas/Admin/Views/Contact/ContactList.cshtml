@model List<Contact>

@{
    ViewData["Title"] = "ContactList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<br /><br />    
<table class="table table-hover">

    <tr>
        <th>#</th>
        <th>Başlık</th>
        <th>Açıklama</th>
        <th>Email</th>
        <th>Telefon</th>
        <th>Lokasyon</th>
        <th>Sil</th>
        <th>Güncelle</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ContactId</td>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>@item.Email</td>
            <td>@item.PhoneNumber</td>
            <td>@item.Location</td>
            <td><a href="/Admin/Contact/DeleteContact/@item.ContactId" class="btn btn-danger">Sil</a></td>
            <td><a href="/Admin/Contact/UpdateContact/@item.ContactId" class="btn btn-warning">Güncelle</a></td>
        </tr>
    }
</table>